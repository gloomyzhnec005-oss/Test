# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...
# Публичный HTTPS-адрес, где доступна игра (Telegram требует https)
WEBAPP_URL=https://your-domain.com
PORT=3000
# Разрешить вход без Telegram (для теста в браузере)
ALLOW_GUESTS=true
# Сид генерации карты
WORLD_SEED=1337
# Запускать бота вместе с сервером
RUN_BOT=true
