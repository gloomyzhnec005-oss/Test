# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...
# Публичный HTTPS-адрес, где доступна игра (Telegram требует https)
WEBAPP_URL=https://your-domain.com
PORT=3000
# Разрешить вход без Telegram (для теста в браузере)
ALLOW_GUESTS=true
# Сид генерации карты
WORLD_SEED=1337
# Запускать бота вместе с сервером
RUN_BOT=true
# Все крутки гачи бесплатные (только для тестов!)
FREE_SPINS=false
# Тестовый режим оплаты: покупки за Stars зачисляются сразу, без Telegram (только для разработки!)
DEV_PAYMENTS=false
# Пароль админ-панели /admin.html (если не задан — сгенерируется и запишется в data/admin_password.txt)
ADMIN_PASSWORD=
# Telegram ID администраторов через запятую: команда /admin в боте открывает панель без пароля
ADMIN_TG_IDS=
# Папка сохранений (по умолчанию ./data; на Railway — подключённый Volume, путь берётся сам)
DATA_DIR=
# Бэкапы сохранений: раз в сколько минут и сколько хранить
BACKUP_EVERY_MIN=60
BACKUP_KEEP=48
# Оплата в TON (дополнительно к Stars): адрес для приёма; курс TON за 1 ⭐; ключ TonCenter (@tonapibot); ссылка возврата в мини-приложение
TON_WALLET=
TON_PER_STAR=0.004
TONCENTER_API_KEY=
TON_TWA_RETURN_URL=
